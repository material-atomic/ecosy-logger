{
  "name": "@ecosy/logger",
  "version": "1.1.0",
  "description": "Multi-format logger strategy for Ecosy Framework",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/ecosy-logger.umd.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js",
      "default": "./dist/*.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && rollup -c",
    "prepublishOnly": "yarn build && yarn test:run",
    "test": "yarn build && yarn test:run",
    "test:run": "node --test \"tests/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/material-atomic/ecosy-logger.git"
  },
  "keywords": [
    "ecosy",
    "logger",
    "gelf",
    "syslog",
    "otlp",
    "cef"
  ],
  "author": "Ecosy",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
